<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- webdav-server: the server itself, for Linux and Windows. Published as one file that runs on the ASP.NET Core 10 Runtime
       installed on the computer: build.ps1 and .github/workflows/release.yml make it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>webdav-server</AssemblyName>
    <RootNamespace>Strongthium.WebDavServer</RootNamespace>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- For the generated calling code of the one Windows call in AtomicFile. There's no unsafe code of our own. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- The runtime isn't inside it: the ASP.NET Core 10 Runtime on the computer runs it. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- A release is the one program: no debug symbols or web host files beside it. -->
  <Target Name="LeaveOut" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebDavServer.Shared\WebDavServer.Shared.csproj" />
  </ItemGroup>
</Project>
