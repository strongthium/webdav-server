<UserControl x:Class="Strongthium.WebDavServer.AdminApp.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="32,28,32,24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox x:Name="KindBox" Width="170" Margin="0,0,8,0" SelectionChanged="Kind_Changed" AutomationProperties.Name="What to show" />
          <Button Content="Refresh" Padding="12,6" Click="Refresh_Click" />
        </StackPanel>
        <TextBlock Text="Log" Style="{StaticResource PageTitle}" />
      </DockPanel>
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="Logins, failures, bans and what the admin has changed: the latest 1000, of up to 90 days kept. A login that keeps working is noted once an hour. Passwords are never in it." />
      <TextBlock x:Name="ProblemText" Style="{StaticResource Problem}" Margin="0,8,0,0" />
    </StackPanel>
    <ListView x:Name="List" BorderThickness="0" Background="Transparent" SelectionMode="Single">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}" />
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="When" Width="125" DisplayMemberBinding="{Binding When}" />
          <GridViewColumn Header="What" Width="100" DisplayMemberBinding="{Binding Kind}" />
          <GridViewColumn Header="From" Width="110" DisplayMemberBinding="{Binding Address}" />
          <GridViewColumn Header="Account" Width="90" DisplayMemberBinding="{Binding Account}" />
          <GridViewColumn Header="Where" Width="65" DisplayMemberBinding="{Binding Scope}" />
          <GridViewColumn Header="What happened" Width="385" DisplayMemberBinding="{Binding Message}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</UserControl>
