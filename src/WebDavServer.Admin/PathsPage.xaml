<UserControl x:Class="Strongthium.WebDavServer.AdminApp.PathsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="32,28,32,24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Add a path" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="0,0,8,0" Click="Add_Click" />
          <Button Content="Change" Padding="12,6" Margin="0,0,8,0" Click="Edit_Click" />
          <Button Content="Delete" Padding="12,6" Click="Delete_Click" />
        </StackPanel>
        <TextBlock Text="Paths" Style="{StaticResource PageTitle}" />
      </DockPanel>
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="The addresses WebDAV and Nextcloud clients connect to, where each keeps its files, and how many failed logins ban an address from it." />
      <TextBlock x:Name="ProblemText" Style="{StaticResource Problem}" Margin="0,8,0,0" />
    </StackPanel>
    <ListView x:Name="List" BorderThickness="0" Background="Transparent" SelectionMode="Single" MouseDoubleClick="Edit_Click">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}" />
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Path" Width="100" DisplayMemberBinding="{Binding Path}" />
          <GridViewColumn Header="Files are kept" Width="155" DisplayMemberBinding="{Binding Layout}" />
          <GridViewColumn Header="In" Width="160" DisplayMemberBinding="{Binding Folder}" />
          <GridViewColumn Header="State" Width="80" DisplayMemberBinding="{Binding State}" />
          <GridViewColumn Header="Nextcloud" Width="80" DisplayMemberBinding="{Binding Nextcloud}" />
          <GridViewColumn Header="Bans after" Width="300" DisplayMemberBinding="{Binding Rule}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</UserControl>
