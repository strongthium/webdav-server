<UserControl x:Class="Strongthium.WebDavServer.AdminApp.AccessPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,24" MaxWidth="860" HorizontalAlignment="Left">
      <DockPanel Margin="0,0,0,4">
        <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" Style="{DynamicResource AccentButtonStyle}" Padding="20,6" VerticalAlignment="Center" Click="Save_Click" />
        <TextBlock Text="Access" Style="{StaticResource PageTitle}" />
      </DockPanel>
      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                 Text="Where connections may come from at all. Each account can narrow it further with a whitelist of its own." />
      <TextBlock x:Name="ProblemText" Style="{StaticResource Problem}" Margin="0,0,0,12" />
      <TextBlock x:Name="SavedText" Style="{StaticResource Caption}" Margin="0,0,0,12" Visibility="Collapsed" Text="Saved. It's in force now." />

      <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12,16,16">
        <StackPanel>
          <TextBlock Text="WebDAV and Nextcloud" Style="{StaticResource Heading}" />
          <TextBlock Text="Server whitelist" Style="{StaticResource Field}" />
          <TextBox x:Name="WhitelistBox" AcceptsReturn="True" MinHeight="84" MaxHeight="200" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Server whitelist" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                     Text="One a line: an address (203.0.113.7), a network (203.0.113.0/24), an AS number (AS64500) or a country (CA). Empty is anywhere. A connection from anywhere else is closed at once, before TLS, and the address banned." />
          <TextBlock Text="How long that ban lasts, in minutes" Style="{StaticResource Field}" />
          <TextBox x:Name="WhitelistBanBox" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="Minutes a whitelist ban lasts" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="10080 is a week. It's the same for accounts' own whitelists." />

          <TextBlock Text="Failed logins at the server's own address" Style="{StaticResource Field}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBox x:Name="FailuresBox" AutomationProperties.Name="Failed logins before a ban" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="failures ban an address (0 never does)" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBox x:Name="WindowBox" AutomationProperties.Name="Minutes failures are counted over" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="minutes they're counted over" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBox x:Name="BanBox" AutomationProperties.Name="Minutes a ban lasts" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="minutes the ban lasts" />
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="For Nextcloud clients connecting to the server itself, not one of its paths. Each path has its own rule, under Paths." />

          <TextBlock Text="Failed logins across all paths, in an hour, that ban an address from everything" Style="{StaticResource Field}" />
          <TextBox x:Name="AcrossBox" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="Failed logins across all paths before a ban" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Each path counts its own too. This is so that more paths don't mean more guesses. 0 never bans." />

          <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="IPv6 bans cover a /" Style="{StaticResource Field}" />
              <TextBox x:Name="PrefixBox" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="Size of an IPv6 ban" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="64 is what one customer usually holds. A smaller number covers more." />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Largest single upload, in GB" Style="{StaticResource Field}" />
              <TextBox x:Name="UploadBox" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Largest upload in gigabytes" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Empty is no limit but the quota." />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12,16,16">
        <StackPanel>
          <TextBlock Text="The admin port" Style="{StaticResource Heading}" />
          <TextBlock Text="Admin whitelist" Style="{StaticResource Field}" />
          <TextBox x:Name="AdminWhitelistBox" AcceptsReturn="True" MinHeight="64" MaxHeight="160" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Admin whitelist" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="The same, for this window. It has to include where you are now. If you ever do shut yourself out, webdav-server --reset-admin on the server clears it." />
          <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Failures that ban" Style="{StaticResource Field}" />
              <TextBox x:Name="AdminFailuresBox" AutomationProperties.Name="Failed admin logins before a ban" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Counted over, minutes" Style="{StaticResource Field}" />
              <TextBox x:Name="AdminWindowBox" AutomationProperties.Name="Minutes failed admin logins are counted over" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Ban lasts, minutes" Style="{StaticResource Field}" />
              <TextBox x:Name="AdminBanBox" AutomationProperties.Name="Minutes an admin ban lasts" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12,16,16">
        <StackPanel>
          <TextBlock Text="Countries and networks" Style="{StaticResource Heading}" />
          <TextBlock x:Name="GeoText" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                     Text="Whitelist rules naming a country or AS number go by DB-IP's free databases, about 12 MB, which the server keeps and looks addresses up in itself: no address is ever sent anywhere. Until they're here, those rules can match nobody: connections they'd need to allow are closed, but not banned." />
          <CheckBox x:Name="GeoAutoBox" Content="Keep them up to date, once a whitelist uses them" Margin="0,10,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="GeoButton" Content="Download now" Padding="12,6" Click="Geo_Click" />
            <ProgressBar x:Name="GeoBusy" Width="120" Height="4" Margin="14,0,0,0" IsIndeterminate="True" Visibility="Collapsed" />
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="IP geolocation and AS data by DB-IP (https://db-ip.com), under CC BY 4.0." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
