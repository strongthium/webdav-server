<Window x:Class="Strongthium.WebDavServer.AdminApp.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account" Width="620" Height="760" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="24,8,24,16">
      <TextBlock x:Name="ProblemText" Style="{StaticResource Problem}" Margin="0,0,0,10" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SaveButton" Content="Save" Style="{DynamicResource AccentButtonStyle}" Padding="20,6" Margin="0,0,8,0" Click="Save_Click" />
        <Button Content="Close" Padding="16,6" IsCancel="True" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,8,24,8">
        <TextBlock Text="Name" Style="{StaticResource Field}" />
        <TextBox x:Name="NameBox" AutomationProperties.Name="Name" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Small letters, digits, dots, dashes and underscores. It can't be changed later: it's also the name of the account's folder." />
        <TextBlock Text="Shown as" Style="{StaticResource Field}" />
        <TextBox x:Name="DisplayBox" AutomationProperties.Name="Shown as" />

        <TextBlock x:Name="PasswordLabel" Text="Password" Style="{StaticResource Field}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <PasswordBox x:Name="PasswordBox1" AutomationProperties.Name="Password" />
          <PasswordBox x:Name="PasswordBox2" Grid.Column="2" AutomationProperties.Name="Password again" />
          <Button Grid.Column="4" Content="Make one" Padding="10,5" Click="Generate_Click" />
        </Grid>
        <TextBox x:Name="GeneratedBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" Margin="0,6,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="PasswordHint" Style="{StaticResource Caption}" Margin="0,4,0,0" Text="At least 12 characters, typed twice." />

        <CheckBox x:Name="EnabledBox" Content="This account can log in" Margin="0,14,0,0" />
        <CheckBox x:Name="AppOnlyBox" Content="Only with app passwords, not this password" Margin="0,6,0,0"
                  ToolTip="WebDAV clients keep the password they're given. An app password can be taken away from one device without touching the others." />

        <TextBlock Text="Paths it may use" Style="{StaticResource Field}" />
        <ItemsControl x:Name="GrantsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="{Binding Label}" IsChecked="{Binding Granted}" />
                <CheckBox Grid.Column="1" Content="Read only" IsChecked="{Binding ReadOnly}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Home, for Nextcloud clients connecting to the server's own address" Style="{StaticResource Field}" />
        <ComboBox x:Name="HomeBox" AutomationProperties.Name="Home path" />

        <TextBlock Text="Quota, in GB" Style="{StaticResource Field}" />
        <TextBox x:Name="QuotaBox" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="Quota in gigabytes" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Empty is no limit. It holds on paths that keep files by account. A path that keeps files by path has a quota of its own." />

        <TextBlock Text="May log in from" Style="{StaticResource Field}" />
        <TextBox x:Name="WhitelistBox" AcceptsReturn="True" MinHeight="70" MaxHeight="140" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="May log in from" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                   Text="One a line: an address (203.0.113.7), a network (203.0.113.0/24), an AS number (AS64500) or a country (CA). Empty is anywhere. A login from anywhere else is cut off and the address banned, even with the right password." />

        <StackPanel x:Name="AppPasswordsPanel" Visibility="Collapsed">
          <TextBlock Text="App passwords" Style="{StaticResource Field}" />
          <ListView x:Name="AppPasswordsList" MaxHeight="130" SelectionMode="Single">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}" />
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn Header="For" Width="240" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="Made" Width="120" DisplayMemberBinding="{Binding Created, StringFormat=d}" />
                <GridViewColumn Header="Last used" Width="130" DisplayMemberBinding="{Binding LastUsed, StringFormat=g}" />
              </GridView>
            </ListView.View>
          </ListView>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AppNameBox" AutomationProperties.Name="What the new app password is for" />
            <Button Grid.Column="2" Content="Make one" Padding="10,5" Click="NewAppPassword_Click" />
            <Button Grid.Column="4" Content="Take it away" Padding="10,5" Click="RemoveAppPassword_Click" />
          </Grid>
          <TextBox x:Name="NewAppPasswordBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" Margin="0,6,0,0" Visibility="Collapsed" />
          <TextBlock x:Name="NewAppPasswordHint" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="Collapsed" Text="Copy it now. It's only shown this once: the server keeps nothing it could be read back from." />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
