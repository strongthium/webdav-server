<UserControl x:Class="Strongthium.WebDavServer.AdminApp.ConnectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="480" Margin="32,32,32,24" HorizontalAlignment="Left" Width="480">
      <TextBlock Text="Connect to a server" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                 Text="The admin port of a webdav-server, on this PC or across the network. A new server's login is admin / admin, and you'll be asked to change it right away." />

      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,4,16,16">
        <StackPanel>
          <TextBlock Text="Server" Style="{StaticResource Field}" />
          <ComboBox x:Name="ServerBox" IsEditable="True" SelectionChanged="Server_Changed" AutomationProperties.Name="Server"
                    ToolTip="The server's name or address, and its admin port if that isn't 9443: files.example.com:9443" />
          <TextBlock Text="Name" Style="{StaticResource Field}" />
          <TextBox x:Name="NameBox" AutomationProperties.Name="Name" />
          <TextBlock Text="Password" Style="{StaticResource Field}" />
          <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Password" KeyDown="Password_KeyDown" />
          <TextBlock x:Name="ProblemText" Style="{StaticResource Problem}" Margin="0,12,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="ConnectButton" Content="Connect" Style="{DynamicResource AccentButtonStyle}" Padding="20,6" Click="Connect_Click" />
            <ProgressBar x:Name="Busy" Width="120" Height="4" Margin="14,0,0,0" IsIndeterminate="True" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Style="{StaticResource Caption}" Margin="4,12,0,0"
                 Text="The password isn't saved. The server's certificate is: you'll be asked to compare it the first time, and warned if it ever changes." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
