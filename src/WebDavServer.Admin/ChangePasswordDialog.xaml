<Window x:Class="Strongthium.WebDavServer.AdminApp.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change the admin password" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20,24,20">
    <TextBlock x:Name="HeadingText" Text="Change the admin password" Style="{StaticResource Heading}" />
    <TextBlock x:Name="WhyText" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" Visibility="Collapsed"
               Text="Everyone knows the default login, so nothing else can be done with it until it's changed. Anyone else logged in is logged out." />
    <StackPanel x:Name="CurrentPanel">
      <TextBlock Text="Current password" Style="{StaticResource Field}" />
      <PasswordBox x:Name="CurrentBox" AutomationProperties.Name="Current password" />
    </StackPanel>
    <TextBlock Text="New name to log in with (optional)" Style="{StaticResource Field}" />
    <TextBox x:Name="NewNameBox" AutomationProperties.Name="New name" />
    <TextBlock Text="New password" Style="{StaticResource Field}" />
    <PasswordBox x:Name="NewBox" AutomationProperties.Name="New password" />
    <TextBlock Text="Again" Style="{StaticResource Field}" />
    <PasswordBox x:Name="AgainBox" AutomationProperties.Name="New password again" />
    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="At least 12 characters. A few words are easier to remember and harder to guess." />
    <TextBlock x:Name="ProblemText" Style="{StaticResource Problem}" Margin="0,12,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="SaveButton" Content="Change it" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
      <Button Content="Cancel" Padding="16,6" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
