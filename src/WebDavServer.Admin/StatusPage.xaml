<UserControl x:Class="Strongthium.WebDavServer.AdminApp.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,24" MaxWidth="980" HorizontalAlignment="Left">
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Content="Change the admin password" Padding="12,6" VerticalAlignment="Center" Click="ChangePassword_Click" />
        <TextBlock Text="Status" Style="{StaticResource PageTitle}" />
      </DockPanel>
      <TextBlock x:Name="ProblemText" Style="{StaticResource Problem}" Margin="0,0,0,12" />

      <ItemsControl x:Name="Warnings" Margin="0,0,0,4">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
              <DockPanel>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,12,0" DockPanel.Dock="Left" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <UniformGrid Columns="4" Margin="-4,0,-4,12">
        <Border Style="{StaticResource Card}" Margin="4"><StackPanel><TextBlock x:Name="ConnectionsText" Text="–" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="connections open" Style="{StaticResource Caption}" /></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="4"><StackPanel><TextBlock x:Name="ClosedText" Text="–" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="closed at the door" Style="{StaticResource Caption}" /></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="4"><StackPanel><TextBlock x:Name="BansText" Text="–" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="bans in force" Style="{StaticResource Caption}" /></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="4"><StackPanel><TextBlock x:Name="AccountsText" Text="–" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="AccountsCaption" Text="accounts" Style="{StaticResource Caption}" /></StackPanel></Border>
      </UniformGrid>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="The server" Style="{StaticResource Heading}" Margin="0,0,0,8" />
          <Grid x:Name="ServerGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Style="{StaticResource Caption}" Margin="4,0,0,0"
                 Text="Which ports it listens on, and its certificate files, are in webdav-server.json in the data folder, and take a restart to change. Everything else takes effect at once." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
