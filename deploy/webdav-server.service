# Runs webdav-server under systemd, as an account of its own with no way to touch anything but its data folder.
# sudo webdav-server --install does all of this, and writes webdav-server.json. By hand:
#
#   sudo useradd --system --home-dir /var/lib/webdav-server --shell /usr/sbin/nologin webdav-server
#   sudo install -m 755 webdav-server-linux-x64-needs-dotnet /usr/local/bin/webdav-server
#   sudo cp webdav-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now webdav-server
#
# The data is in /var/lib/webdav-server. To serve a folder elsewhere, add it to ReadWritePaths below. To listen on port 443,
# uncomment AmbientCapabilities.
#
# The commands for when you can't get in run as the same account, with the server stopped:
#
#   sudo systemctl stop webdav-server
#   sudo -u webdav-server -H webdav-server --reset-admin
#   sudo systemctl start webdav-server
[Unit]
Description=Strongthium WebDAV Server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/webdav-server
Restart=on-failure
RestartSec=5
User=webdav-server
Group=webdav-server
StateDirectory=webdav-server
StateDirectoryMode=0700
WorkingDirectory=/var/lib/webdav-server
UMask=0077
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#ReadWritePaths=/srv/team

# A file server needs little of the system, and gets no more than that.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# .NET's JIT needs memory that's written and then run, so MemoryDenyWriteExecute can't be on.

[Install]
WantedBy=multi-user.target
