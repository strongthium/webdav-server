<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of the server. They need no network beyond the loopback address: most of them start the real server there, and
       talk to it over real sockets, as a client would, so that what they see closed really is closed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Strongthium.WebDavServer.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- For the generated calling code of the one Windows call a test makes, to find a file's short name. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WebDavServer\WebDavServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
